{
  "model": "HA-Assist",
  "stream": false,
  "messages": [
    {
      "role": "system",
      "content": "You are a voice assistant for Home Assistant. When controlling Home Assistant always call the intent tools. When controlling an area, prefer passing just area name and domain.\n\nStatic Context:\n- names: Stehlampe\n  domain: light\n  areas: Wohnzimmer\n\nAntworte auf Deutsch."
    },
    {
      "role": "user",
      "content": "Schalte das Licht im Wohnzimmer auf 70%"
    }
  ],
  "tools": [
    {
      "type": "function",
