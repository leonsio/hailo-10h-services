[Unit]
Description=Hailo-10H resident Qwen2-VL and Whisper gateway (SHARED)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=hailo-services
Group=hailo-services
StateDirectory=hailo-10h-services
StateDirectoryMode=0750
WorkingDirectory=/var/lib/hailo-10h-services
EnvironmentFile=-/etc/hailo-10h-services.env
Environment=HAILO_CONFIG=/etc/hailo-10h-services.yaml
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/var/lib/hailo-10h-services
ExecStartPre=/opt/hailo-10h-services/venv/bin/python -m hailo_services.preflight
ExecStart=/opt/hailo-10h-services/venv/bin/hailo-10h-services
Restart=on-failure
RestartSec=15
# First launch downloads large HEFs. Type=simple has no readiness deadline.
TimeoutStopSec=240
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
# ProtectSystem also covers /usr/local; ACLs alone cannot permit downloads there.
ReadWritePaths=/usr/local/hailo/resources/models/hailo10h
ProtectHome=read-only
UMask=0022

[Install]
WantedBy=multi-user.target
