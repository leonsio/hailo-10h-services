HAILO_HOST=0.0.0.0
HAILO_PORT=8090
HAILO_WYOMING_HOST=0.0.0.0
HAILO_WYOMING_PORT=10300
# Installer generates a random key for HTTP, MCP and WebSocket.
HAILO_API_KEY=
HAILO_LANGUAGE=de
HAILO_QUEUE_SIZE=8
HAILO_REQUEST_TIMEOUT=180
HAILO_MAX_BODY=16777216
HAILO_MAX_AUDIO_SECONDS=120
# Names use hailo-apps' standard resource resolver and auto-download.
HAILO_VLM_HEF=Qwen2-VL-2B-Instruct
HAILO_WHISPER_HEF=Whisper-Base
# MCP hostname allowlist: add the actual IP/name used by your clients.
HAILO_MCP_HOSTS=localhost:*,127.0.0.1:*,hailo.local:*
# Leave host empty to disable MQTT. Configure broker ACLs for this prefix.
HAILO_MQTT_HOST=
HAILO_MQTT_PORT=1883
HAILO_MQTT_USERNAME=
HAILO_MQTT_PASSWORD=
HAILO_MQTT_PREFIX=hailo10h
HAILO_MQTT_TLS=false
